# ─────────────────────────────────────────────────────────────────────────────
# Cazalia — variables d'environnement du service API
#
# En production (CT LXC 120), ces variables ne sont PAS lues depuis un fichier
# .env : elles sont fournies par systemd via un EnvironmentFile en mode 0600
# (cf. deploy/lucie-cowork.service). Ce fichier sert de RÉFÉRENCE et de modèle.
#
#   cp .env.example /etc/lucie-cowork/lucie-cowork.env
#   chmod 600 /etc/lucie-cowork/lucie-cowork.env
#   chown root:root /etc/lucie-cowork/lucie-cowork.env
#
# Ne jamais versionner le fichier renseigné (.gitignore couvre `.env*`).
# ─────────────────────────────────────────────────────────────────────────────

# ── Exécution ────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
# Interface d'écoute. LAISSER 127.0.0.1 : l'API doit être joignable UNIQUEMENT
# par le reverse proxy nginx local. Exposée sur 0.0.0.0 avec TRUST_PROXY=1, elle
# permettrait de forger X-Forwarded-For et de contourner la limitation de débit.
HOST=127.0.0.1
# Nombre de proxys de confiance devant l'API (nginx local = 1).
# Mettre 0 si l'API est un jour exposée sans proxy.
TRUST_PROXY=1
# Taille maximale d'un corps JSON.
JSON_BODY_LIMIT=100kb
# Hôtes supplémentaires autorisés à émettre des requêtes mutantes (garde CSRF).
# L'hôte de la requête courante est toujours accepté — inutile d'y lister
# `cowork.example.com` ni `10.0.0.0`, qui sont déjà l'hôte de la requête.
# Séparateur : virgule.
# ALLOWED_ORIGINS=autre-alias.exemple.fr

# ⚠️ TRUST_PROXY reste à 1 même avec deux proxys en cascade (NginxProxy le reverse proxy →
# nginx le conteneur). C'est nginx du le conteneur qui restitue l'adresse réelle du client,
# via `set_real_ip_from` : l'API n'a donc qu'un seul maillon à remonter. Passer
# cette valeur à 2 rendrait `X-Forwarded-For` falsifiable depuis le LAN.

# ── Données ──────────────────────────────────────────────────────────────────
DB_PATH=/var/lib/lucie-cowork/cowork.db
GALLERY_DIR=/opt/lucie-cowork/web/gallery

# ── Secrets (OBLIGATOIRES en production) ─────────────────────────────────────
# Clé de chiffrement au repos (AES-256-GCM) des secrets stockés en base :
# mot de passe SMTP et secrets TOTP. Générer avec :
#   openssl rand -hex 32
# ⚠️ La CHANGER rend illisibles les secrets déjà chiffrés : le mot de passe SMTP
# devra être re-saisi dans /admin/emails et les membres devront reconfigurer
# leur double authentification.
APP_SECRET=

# Mot de passe attribué aux comptes créés depuis le back-office. L'utilisateur
# est forcé de le changer à sa première connexion. Sans cette variable, une
# valeur aléatoire est générée à chaque démarrage du service.
#   openssl rand -base64 18
DEFAULT_USER_PASSWORD=

# ── Règles métier ────────────────────────────────────────────────────────────
# Fenêtre de remboursement intégral à l'annulation (heures avant le créneau).
REFUND_WINDOW_HOURS=24
# Durée de validité d'un lien de réinitialisation de mot de passe (ms). 2 h.
RESET_TOKEN_TTL_MS=7200000
# Nombre maximal de créneaux dans une réservation groupée (plafond anti-DoS).
MAX_SLOTS_PER_BATCH=60
# URL publique utilisée dans les e-mails (liens de reset, tableau de bord).
PUBLIC_BASE_URL=https://cowork.example.com

# ── Politique de mot de passe / hachage ──────────────────────────────────────
# Longueur minimale exigée (la politique impose en plus 3 familles de
# caractères sur 4 et refuse les mots de passe notoirement fuités).
PASSWORD_MIN_LENGTH=10
# Coût scrypt. N doit être une puissance de 2 ; SCRYPT_MAXMEM doit rester
# supérieur à 128 * N * r octets. Valeurs par défaut : 65536 / 8 / 1 (~64 Mio).
# Ne relever N que si la RAM du conteneur augmente (actuellement 1 Gio).
# SCRYPT_N=65536
# SCRYPT_R=8
# SCRYPT_P=1
# SCRYPT_MAXMEM=134217728

# ── SMTP (repli si aucun réglage n'est saisi dans /admin/emails) ─────────────
# La configuration saisie dans le back-office PRIME sur ces variables, et son
# mot de passe y est chiffré au repos — à privilégier.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
SMTP_FROM=Cazalia <no-reply@cowork.example.com>

# ── Intégration UniFi (voucher Wi-Fi par réservation) ───────────────────────
# Deux modes, la clé d'API étant requise dans les deux cas.
#  • CLOUD (recommandé) : clé créée sur unifi.ui.com + identifiant de console.
#    Le serveur sort par Internet, aucune route vers le LAN de l'UDM n'est
#    nécessaire, et la validation TLS standard s'applique.
#  • LOCAL : clé d'intégration locale + hôte de l'UDM. Le contrôleur présente un
#    certificat auto-signé : préciser alors UNE stratégie TLS explicite,
#    faute de quoi l'intégration refuse de se connecter.
UNIFI_API_KEY=
UNIFI_CONSOLE_ID=
# UNIFI_HOST=10.1.10.1
UNIFI_SITE=default
UNIFI_VOUCHER_MINUTES=1440
# UNIFI_VOUCHER_GUEST_LIMIT=

# Mode LOCAL uniquement — épinglage du certificat (RECOMMANDÉ) :
#   openssl s_client -connect <udm>:443 </dev/null 2>/dev/null \
#     | openssl x509 -noout -fingerprint -sha256
# UNIFI_TLS_FINGERPRINT=AA:BB:CC:...
# Mode LOCAL uniquement — désactivation assumée de la validation TLS.
# À n'utiliser que sur un segment réseau de confiance.
# UNIFI_INSECURE_TLS=1
